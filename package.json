{
  "name": "docs-collab-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_ENV=production next build --turbopack",
    "vercel-build": "npx prisma generate && npx prisma migrate deploy && npm run build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "biome check --write && biome format --write",
    "lint:md": "rumdl check .",
    "lint:md:fix": "rumdl fmt .",
  "db:up": "docker compose up -d",
  "db:down": "docker compose down",
  "db:restart": "docker compose down && docker compose up -d",
    "local-dev": "bun run db:up && concurrently -k -n \"STUDIO,NEXT\" -c \"cyan,green\" \"BROWSER=none npx prisma studio\" \"npm run dev\"",
    "deploy:preview": "npx vercel",
    "deploy:prod": "npx vercel --prod",
    "vercel:env:pull": "npx vercel env pull .env.local"
  },
